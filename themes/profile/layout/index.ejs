<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="<%= config.description %>">
    <meta name="theme-color" content="#071b2f">
    <meta property="og:title" content="Yifan Wu — Multimodal AI for Earth Observation">
    <meta property="og:description" content="Research and engineering across remote sensing, vision-language learning, speech AI, and intelligent systems.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= config.url %>">
    <meta property="og:image" content="<%= site.data.profile.avatar %>">
    <title>Yifan Wu — Multimodal AI for Earth Observation</title>
    <link rel="canonical" href="<%= config.url %>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="<%- url_for('/css/style.css') %>">
    <script defer src="<%- url_for('/js/main.js') %>"></script>
  </head>
  <body>
    <% const profile = site.data.profile; %>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" id="top">
      <a class="brand" href="#top" aria-label="Yifan Wu, home">
        <span class="brand-mark"><%= profile.initials %></span>
        <span><%= profile.name %></span>
      </a>
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-navigation">
        <span></span><span></span><span></span>
        <span class="sr-only">Toggle navigation</span>
      </button>
      <nav id="site-navigation" aria-label="Primary navigation">
        <a href="#research">Research</a>
        <a href="#projects">Projects</a>
        <a href="#education">Education</a>
        <a class="nav-contact" href="mailto:<%= profile.email %>">Contact</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero section-shell" aria-labelledby="hero-title">
        <div class="hero-copy reveal">
          <p class="eyebrow"><span class="eyebrow-dot"></span><%= profile.eyebrow %></p>
          <h1 id="hero-title"><%= profile.headline %></h1>
          <p class="hero-summary"><%= profile.summary %></p>
          <div class="hero-actions">
            <a class="button button-primary" href="#research">Explore my work <span aria-hidden="true">↘</span></a>
            <a class="button button-quiet" href="<%= profile.github %>" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <aside class="profile-card reveal" aria-label="Profile details">
          <div class="portrait-wrap">
            <div class="orbit orbit-one"></div>
            <div class="orbit orbit-two"></div>
            <img src="<%= profile.avatar %>" alt="Portrait of <%= profile.name %>" width="220" height="220">
            <span class="signal-dot signal-dot-one"></span>
            <span class="signal-dot signal-dot-two"></span>
          </div>
          <div class="profile-card-copy">
            <p class="profile-name"><%= profile.name %></p>
            <p>B.Eng. Candidate · BUPT</p>
            <div class="profile-links">
              <a href="mailto:<%= profile.email %>"><%= profile.email %></a>
              <a href="<%= profile.github %>" target="_blank" rel="noreferrer">github.com/<%= profile.github_label %></a>
            </div>
          </div>
        </aside>
      </section>

      <div class="marquee" aria-hidden="true">
        <div class="marquee-track">
          <% [...profile.strengths, ...profile.strengths].forEach(function(item) { %>
            <span><%= item %></span><i></i>
          <% }); %>
        </div>
      </div>

      <section class="section section-shell" id="research" aria-labelledby="research-title">
        <div class="section-heading reveal">
          <p class="section-kicker">01 · Featured research</p>
          <h2 id="research-title">Aligning every sensor with language.</h2>
          <p>Learning a shared semantic space across optical, radar, and multispectral Earth observation.</p>
        </div>

        <article class="research-card reveal">
          <div class="research-intro">
            <div class="research-meta">
              <span><%= profile.research.role %></span>
              <span><%= profile.research.status %></span>
            </div>
            <p class="research-type"><%= profile.research.subtitle %></p>
            <h3><%= profile.research.title %></h3>
            <p><%= profile.research.description %></p>
            <a class="text-link" href="<%= profile.research.repository %>" target="_blank" rel="noreferrer">
              View <%= profile.research.repository_label %> on GitHub <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="method-map" role="img" aria-label="PANORAMA method overview">
            <div class="sensor sensor-rgb"><span>RGB</span><small>Frozen VLM</small></div>
            <div class="sensor sensor-sar"><span>SAR</span><small>Independent encoder</small></div>
            <div class="sensor sensor-ms"><span>MS</span><small>Independent encoder</small></div>
            <div class="alignment-core"><span>PANORAMA</span><small>Language-aligned space</small></div>
            <svg class="method-lines" viewBox="0 0 500 320" aria-hidden="true">
              <path d="M126 72 C220 62 230 126 250 160" />
              <path d="M126 248 C220 258 230 196 250 160" />
              <path d="M374 72 C280 62 270 126 250 160" />
              <path d="M374 248 C280 258 270 196 250 160" />
            </svg>
          </div>
          <div class="method-list">
            <% profile.research.methods.forEach(function(method) { %><span><%= method %></span><% }); %>
          </div>
          <div class="metrics">
            <% profile.research.results.forEach(function(result) { %>
              <div class="metric">
                <strong><%= result.value %></strong>
                <span><%= result.label %></span>
              </div>
            <% }); %>
          </div>
          <p class="benchmarks"><strong>Evaluated on</strong> <%= profile.research.benchmarks %></p>
        </article>
      </section>

      <section class="section section-shell" id="projects" aria-labelledby="projects-title">
        <div class="section-heading reveal">
          <p class="section-kicker">02 · Selected projects</p>
          <h2 id="projects-title">From models to working systems.</h2>
          <p>Research-driven engineering across geospatial intelligence, speech health, and foundation-model vision.</p>
        </div>

        <div class="project-list">
          <% profile.projects.forEach(function(project, index) { %>
            <article class="project-card reveal">
              <div class="project-index"><%= String(index + 1).padStart(2, '0') %></div>
              <div class="project-main">
                <div class="project-meta"><span><%= project.role %></span><span><%= project.dates %></span></div>
                <h3><%= project.title %></h3>
                <p><%= project.description %></p>
                <ul>
                  <% project.highlights.forEach(function(highlight) { %><li><%= highlight %></li><% }); %>
                </ul>
                <% if (project.link) { %>
                  <a class="text-link" href="<%= project.link %>" target="_blank" rel="noreferrer"><%= project.link_label %> <span aria-hidden="true">↗</span></a>
                <% } %>
              </div>
              <div class="tag-list" role="list" aria-label="Technologies">
                <% project.tags.forEach(function(tag) { %><span role="listitem"><%= tag %></span><% }); %>
              </div>
            </article>
          <% }); %>
        </div>
      </section>

      <section class="section section-shell split-section" id="education" aria-labelledby="education-title">
        <div class="section-heading reveal">
          <p class="section-kicker">03 · Education &amp; recognition</p>
          <h2 id="education-title">A foundation in signals, systems, and computation.</h2>
        </div>
        <div class="education-grid">
          <article class="education-card reveal">
            <span class="card-label">Education</span>
            <h3><%= profile.education.institution %></h3>
            <p class="degree"><%= profile.education.degree %></p>
            <p class="dates"><%= profile.education.dates %> · <%= profile.education.location %></p>
            <div class="coursework">
              <% profile.education.coursework.forEach(function(course) { %><span><%= course %></span><% }); %>
            </div>
          </article>
          <article class="awards-card reveal">
            <span class="card-label">Awards &amp; language</span>
            <ol>
              <% profile.awards.forEach(function(award, index) { %><li><span>0<%= index + 1 %></span><%= award %></li><% }); %>
            </ol>
            <p class="language-line"><strong>English</strong><%= profile.language %></p>
          </article>
        </div>
      </section>

      <section class="contact section-shell reveal" aria-labelledby="contact-title">
        <p class="section-kicker">Let’s connect</p>
        <h2 id="contact-title">Interested in multimodal AI, Earth observation, or intelligent systems?</h2>
        <p>I’m always glad to exchange ideas about research and engineering.</p>
        <div class="contact-links">
          <a class="button button-light" href="mailto:<%= profile.email %>">Email me <span aria-hidden="true">↗</span></a>
          <a class="contact-github" href="<%= profile.github %>" target="_blank" rel="noreferrer">@<%= profile.github_label %> on GitHub</a>
        </div>
      </section>
    </main>

    <footer class="site-footer section-shell">
      <p>© <%= new Date().getFullYear() %> <%= profile.name %></p>
      <p>Built with Hexo · Deployed on GitHub Pages</p>
      <a href="#top">Back to top ↑</a>
    </footer>
  </body>
</html>
